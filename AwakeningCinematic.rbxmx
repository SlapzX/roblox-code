<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="LocalScript" referent="RBX0">
		<Properties>
			<string name="Name">AwakeningCinematic</string>
			<bool name="Disabled">false</bool>
			<ProtectedString name="Source"><![CDATA[--[[
	╔══════════════════════════════════════════════════════════════════╗
	║                      A  W  A  K  E  N  I  N  G                    ║
	║             a 60-second procedural cinematic for Roblox            ║
	╚══════════════════════════════════════════════════════════════════╝

	TYPE:   LocalScript
	PLACE:  StarterPlayer ▸ StarterPlayerScripts
	NEEDS:  nothing else. Every part, light, beam, particle, sound and UI
	        element is generated by this script, and removed afterwards.

	CONTROLS
	  X  – skip (or click the SKIP button)
	  P  – replay

	The whole scene is built on the client (only the watching player sees it),
	thousands of studs away from your map. Your Lighting, camera, controls and
	CoreGui are saved before it starts and restored when it ends.

	STORY BEATS (seconds)
	  00–05  Cold open        black screen, letterbox, typewriter narration
	  05–13  Establishing     bezier fly-over of a floating island at night
	  13–21  The runes        eight pillars ignite and fire beams at a crystal
	  21–28  Awakening        crystal spins up, energy implodes, rocks levitate
	  28–34  The storm        sky turns blood red, procedural lightning
	  34–37  Silence          desaturated push-in, heartbeats
	  37–45  Shatter          explosion, shockwave, shards… then BULLET TIME
	  45–53  Ascension        an orb with gyroscope rings rises, dawn breaks
	  53–60  Supernova        pull-back, white-out, glitch title card
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local SoundService = game:GetService("SoundService")

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local player = Players.LocalPlayer

------------------------------------------------------------------------
-- CONFIG — tweak me
------------------------------------------------------------------------
local CONFIG = {
	PLAY_ON_JOIN = true, -- play automatically when the player spawns
	JOIN_DELAY = 3, -- seconds to wait after spawning
	REPLAY_KEY = Enum.KeyCode.P,
	SKIP_KEY = Enum.KeyCode.X,

	-- Optional: touching a part with this name (anywhere in Workspace) plays it.
	TRIGGER_PART_NAME = "CinematicTrigger",

	-- Where the scene is built. Far away from a normal map on purpose.
	ORIGIN = Vector3.new(6000, 900, 6000),

	-- Optional music: paste an audio id from the Creator Store, e.g.
	-- "rbxassetid://1234567890". Leave empty for no music.
	MUSIC_ID = "",
	MUSIC_VOLUME = 0.5,

	-- Built-in engine sounds, so it works with zero uploads. Swap any of
	-- these for "rbxassetid://<id>" from the Creator Store for more punch.
	SOUNDS = {
		Rune = "rbxasset://sounds/electronicpingshort.wav",
		Whoosh = "rbxasset://sounds/swordlunge.wav",
		Shatter = "rbxasset://sounds/glassbreak.wav",
		Drone = "rbxasset://sounds/action_falling.mp3", -- pitched way down = rumble
		Heartbeat = "rbxasset://sounds/action_jump_land.mp3", -- pitched down = thump
	},
}

------------------------------------------------------------------------
-- CONSTANTS
------------------------------------------------------------------------
local VIOLET = Color3.fromRGB(170, 85, 255)
local CYAN = Color3.fromRGB(80, 225, 255)
local GOLD = Color3.fromRGB(255, 196, 92)
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local DARK = Color3.fromRGB(28, 22, 40)
local STONE = Color3.fromRGB(62, 60, 72)
local STONE_LIGHT = Color3.fromRGB(78, 76, 90)
local BOLT_COLORS = { CYAN, VIOLET, Color3.fromRGB(255, 120, 150), WHITE }

local TEX = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

local ORIGIN = CONFIG.ORIGIN -- top-centre of the island's grass
local CRYSTAL = ORIGIN + Vector3.new(0, 14, 0)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a Cylinder's axis to world-Y
local DIAMOND = CFrame.Angles(0, 0, math.rad(35.264)) * CFrame.Angles(math.rad(45), 0, 0) -- cube on its tip
local CIRCLE_BASE = CFrame.new(ORIGIN + Vector3.new(0, 0.07, 0))
local GRAVITY = Vector3.new(0, -80, 0)
local RENDER_NAME = "AwakeningCinematic"
local VIGNETTE_BASE = 0.35
local TITLE_TEXT = "A W A K E N I N G"
local GLYPHS = "!<>-_\\/[]{}=+*^?#%&@$"

local function pickFont(name, fallback)
	local ok, font = pcall(function()
		return Enum.Font[name]
	end)
	return (ok and font) or fallback
end
local TITLE_FONT = pickFont("Michroma", Enum.Font.GothamBlack)
local SUB_FONT = pickFont("Merriweather", Enum.Font.Garamond)

------------------------------------------------------------------------
-- STATE (reset on every play)
------------------------------------------------------------------------
local rng = Random.new()
local camera = workspace.CurrentCamera
local controls

local playing, finishing = false, false
local cooldownUntil = 0
local sceneFolder
local S = {} -- scene references
local U = {} -- UI references
local saved = {}
local created, tweens, threads, emitters, scaledAnims = {}, {}, {}, {}, {}
local timeScale, rumble -- NumberValues: global slow-mo factor and constant camera rumble
local trauma, fovKick, sceneT = 0, 0, 0
local camShot, lastBaseCF
local t0 = 0

------------------------------------------------------------------------
-- SMALL HELPERS
------------------------------------------------------------------------
local function lerp(a, b, t)
	return a + (b - a) * t
end

local function new(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function track(inst)
	table.insert(created, inst)
	return inst
end

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = CFrame.new(ORIGIN)
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = sceneFolder
	return p
end

-- Flat cylinder standing upright (Roblox cylinders lie along X by default).
local function disc(pos, diameter, height, props)
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = CFrame.new(pos) * UPRIGHT
	return part(props)
end

local function seq(points)
	local kps = {}
	for i, p in ipairs(points) do
		kps[i] = NumberSequenceKeypoint.new(p[1], p[2])
	end
	return NumberSequence.new(kps)
end

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = TEX.Sparkle
	e.LightEmission = 1
	e.LightInfluence = 0
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Parent = parent
	table.insert(emitters, e)
	return e
end

local function tween(obj, time, props, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	table.insert(tweens, tw)
	return tw
end

local function spawnT(fn, ...)
	local th = task.spawn(fn, ...)
	table.insert(threads, th)
	return th
end

-- Wait until a given second of the timeline (drift-free).
local function at(second)
	local remaining = (t0 + second) - os.clock()
	if remaining > 0 then
		task.wait(remaining)
	end
end

local function sfx(id, volume, speed, looped)
	if not id or id == "" or not sceneFolder then
		return nil
	end
	-- A Sound that isn't inside a part/attachment plays "2D" at full volume.
	local s = new("Sound", {
		SoundId = id,
		Volume = volume or 0.5,
		PlaybackSpeed = speed or 1,
		Looped = looped == true,
	}, sceneFolder)
	s:Play()
	if not looped then
		s.Ended:Once(function()
			s:Destroy()
		end)
	end
	return s
end

-- Explosions bring their own built-in boom. Invisible ones are pure sound.
local function boom(pos, visible)
	local e = new("Explosion", {
		Position = pos,
		BlastRadius = 2,
		BlastPressure = 0,
		DestroyJointRadiusPercent = 0,
		ExplosionType = Enum.ExplosionType.NoCraters,
	})
	if not visible and not pcall(function()
		e.Visible = false
	end) then
		e:Destroy()
		return
	end
	e.Parent = sceneFolder
end

-- Time-scaled animation: obeys bullet time, unlike TweenService.
local function scaledAnim(duration, fn, style, dir, onDone)
	table.insert(scaledAnims, {
		t = 0,
		d = duration,
		fn = fn,
		style = style or Enum.EasingStyle.Quad,
		dir = dir or Enum.EasingDirection.Out,
		done = onDone,
	})
end

local function addShake(amount)
	trauma = math.min(1, trauma + amount)
end

local function orbPos()
	return CRYSTAL + Vector3.new(0, S.orbHeight.Value, 0)
end

------------------------------------------------------------------------
-- CAMERA DIRECTOR
-- A "shot" is a function of eased alpha (0→1) that returns CFrame + FOV.
-- Shake and FOV kicks are layered on top every frame.
------------------------------------------------------------------------
local function setShot(duration, fn, style, dir)
	camShot = {
		fn = fn,
		start = os.clock(),
		duration = duration,
		style = style or Enum.EasingStyle.Sine,
		dir = dir or Enum.EasingDirection.InOut,
	}
end

local function bezier(points, t)
	local pts = table.clone(points)
	for n = #pts, 2, -1 do
		for i = 1, n - 1 do
			pts[i] = pts[i]:Lerp(pts[i + 1], t)
		end
	end
	return pts[1]
end

local function shotPath(duration, posPoints, lookPoints, fov0, fov1, style, dir)
	setShot(duration, function(a)
		return CFrame.lookAt(bezier(posPoints, a), bezier(lookPoints, a)), lerp(fov0, fov1, a)
	end, style, dir)
end

local function shotOrbit(duration, center, r0, r1, h0, h1, deg0, deg1, fov0, fov1, style, dir)
	setShot(duration, function(a)
		local r, ang = lerp(r0, r1, a), math.rad(lerp(deg0, deg1, a))
		local pos = center + Vector3.new(math.cos(ang) * r, lerp(h0, h1, a), math.sin(ang) * r)
		return CFrame.lookAt(pos, center), lerp(fov0, fov1, a)
	end, style, dir)
end

local function evalShot()
	if not camShot then
		return lastBaseCF, camera.FieldOfView
	end
	local x = math.clamp((os.clock() - camShot.start) / camShot.duration, 0, 1)
	return camShot.fn(TweenService:GetValue(x, camShot.style, camShot.dir))
end

------------------------------------------------------------------------
-- SAVE / RESTORE THE PLAYER'S WORLD
------------------------------------------------------------------------
local LIGHT_PROPS = {
	"Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "FogStart", "FogEnd", "FogColor",
	"ExposureCompensation", "GlobalShadows", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
	"ColorShift_Top", "ColorShift_Bottom",
}

local function getControls()
	local ok, result = pcall(function()
		local scripts = player:WaitForChild("PlayerScripts", 5)
		local module = scripts and scripts:WaitForChild("PlayerModule", 5)
		return require(module):GetControls()
	end)
	return ok and result or nil
end

local function saveEnvironment()
	saved = { lighting = {}, hidden = {}, disabled = {}, coreGui = {} }
	for _, prop in ipairs(LIGHT_PROPS) do
		saved.lighting[prop] = Lighting[prop]
	end
	-- Temporarily remove the game's own sky/atmosphere and switch off its
	-- post effects so ours aren't fighting them.
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") or child:IsA("Atmosphere") then
			table.insert(saved.hidden, child)
			child.Parent = nil
		elseif child:IsA("PostEffect") and child.Enabled then
			table.insert(saved.disabled, child)
			child.Enabled = false
		end
	end
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	if clouds and clouds.Enabled then
		table.insert(saved.disabled, clouds)
		clouds.Enabled = false
	end
	saved.reverb = SoundService.AmbientReverb
	saved.fov = camera.FieldOfView
	saved.cameraType = camera.CameraType
	saved.mouseIcon = UserInputService.MouseIconEnabled
	for _, kind in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		if kind ~= Enum.CoreGuiType.All then
			saved.coreGui[kind] = StarterGui:GetCoreGuiEnabled(kind)
		end
	end
end

local function restoreEnvironment()
	for prop, value in pairs(saved.lighting) do
		Lighting[prop] = value
	end
	for _, inst in ipairs(saved.hidden) do
		inst.Parent = Lighting
	end
	for _, inst in ipairs(saved.disabled) do
		inst.Enabled = true
	end
	SoundService.AmbientReverb = saved.reverb
	camera.CameraType = saved.cameraType
	camera.FieldOfView = saved.fov
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	UserInputService.MouseIconEnabled = saved.mouseIcon
	for kind, enabled in pairs(saved.coreGui) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, kind, enabled)
	end
	if controls then
		controls:Enable()
	end
end

------------------------------------------------------------------------
-- LIGHTING & POST-PROCESSING
------------------------------------------------------------------------
local function buildLighting()
	Lighting.ClockTime = 0
	Lighting.Brightness = 1.6
	Lighting.Ambient = Color3.fromRGB(35, 28, 55)
	Lighting.OutdoorAmbient = Color3.fromRGB(55, 45, 85)
	Lighting.ExposureCompensation = 0.25
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.8

	S.sky = track(new("Sky", {
		StarCount = 5000,
		CelestialBodiesShown = true,
		MoonAngularSize = 18,
		SunAngularSize = 24,
	}, Lighting))
	S.atmosphere = track(new("Atmosphere", {
		Density = 0.32,
		Offset = 0.15,
		Color = Color3.fromRGB(110, 80, 170),
		Decay = Color3.fromRGB(50, 25, 90),
		Glare = 0.4,
		Haze = 1.8,
	}, Lighting))
	S.cc = track(new("ColorCorrectionEffect", { Contrast = 0.1, Saturation = 0.1 }, Lighting))
	S.bloom = track(new("BloomEffect", { Intensity = 1, Size = 30, Threshold = 0.9 }, Lighting))
	S.blur = track(new("BlurEffect", { Size = 0 }, Lighting))
	S.dof = track(new("DepthOfFieldEffect", {
		FarIntensity = 0.35,
		FocusDistance = 90,
		InFocusRadius = 50,
		NearIntensity = 0.3,
	}, Lighting))
	S.sunRays = track(new("SunRaysEffect", { Intensity = 0.02, Spread = 0.7 }, Lighting))
end

------------------------------------------------------------------------
-- THE WORLD
------------------------------------------------------------------------
local function buildIsland()
	-- Grass top + a stack of shrinking rock discs = floating island.
	disc(ORIGIN - Vector3.new(0, 2, 0), 150, 4, {
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(40, 58, 50),
	})
	for i = 1, 7 do
		disc(Vector3.new(ORIGIN.X, ORIGIN.Y - 4 - i * 8, ORIGIN.Z), 150 - i * 19, 10, {
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(58 - i * 3, 54 - i * 3, 64 - i * 2),
		})
	end
	-- Jagged rocks hanging off the underside (always below the grass line).
	for _ = 1, 30 do
		local a = rng:NextNumber(0, math.pi * 2)
		local depth = rng:NextNumber(6, 50)
		local r = math.min(rng:NextNumber(8, 62), 75 - depth * 1.1)
		local h = rng:NextNumber(12, 30)
		part({
			Size = Vector3.new(rng:NextNumber(6, 14), h, rng:NextNumber(6, 14)),
			CFrame = CFrame.new(ORIGIN + Vector3.new(math.cos(a) * r, -(depth + h / 2) + 3, math.sin(a) * r))
				* CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6), rng:NextNumber(-0.5, 0.5)),
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(50, 47, 56),
		})
	end
	-- Boulders on top (kept out of the pillar ring).
	for _ = 1, 22 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(20, 70)
		if math.abs(r - 42) > 5 then
			local s = rng:NextNumber(1.5, 5)
			part({
				Size = Vector3.new(s * rng:NextNumber(1, 1.6), s, s * rng:NextNumber(1, 1.6)),
				CFrame = CFrame.new(ORIGIN + Vector3.new(math.cos(a) * r, s * 0.3, math.sin(a) * r))
					* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)),
				Material = Enum.Material.Rock,
				Color = Color3.fromRGB(70, 68, 78),
			})
		end
	end
	-- Bioluminescent mushrooms.
	for _ = 1, 16 do
		local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(24, 68)
		local base = ORIGIN + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
		part({
			Size = Vector3.new(0.3, 1.2, 0.3),
			CFrame = CFrame.new(base + Vector3.new(0, 0.6, 0)),
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(200, 200, 210),
		})
		local cap = part({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(base + Vector3.new(0, 1.3, 0)),
			Material = Enum.Material.Neon,
			Color = CYAN,
			CastShadow = false,
		})
		new("PointLight", { Color = CYAN, Range = 8, Brightness = 1 }, cap)
	end
	-- Stepped altar.
	disc(ORIGIN + Vector3.new(0, 1, 0), 30, 2, { Material = Enum.Material.Slate, Color = STONE })
	disc(ORIGIN + Vector3.new(0, 3, 0), 22, 2, { Material = Enum.Material.Slate, Color = STONE_LIGHT })
	disc(ORIGIN + Vector3.new(0, 5, 0), 14, 2, { Material = Enum.Material.Marble, Color = Color3.fromRGB(95, 90, 110) })

	-- Two counter-rotating magic circles made of neon dashes (dark until lit).
	S.circles = {}
	for ring = 1, 2 do
		local radius = 15 + ring * 4
		local count = 28 + ring * 8
		local segs = {}
		for j = 1, count do
			segs[j] = {
				angle = j / count * math.pi * 2,
				part = part({
					Size = Vector3.new(0.5, 0.12, radius * math.pi * 2 / count * 0.7),
					Material = Enum.Material.Neon,
					Color = DARK,
					CastShadow = false,
				}),
			}
		end
		S.circles[ring] = { segs = segs, radius = radius, dir = ring == 1 and 1 or -1 }
	end

	-- Ground cracks that glow after the shatter (hidden for now).
	S.cracks = {}
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local len = rng:NextNumber(18, 40)
		local outward = Vector3.new(math.cos(a), 0, math.sin(a))
		local mid = ORIGIN + outward * (15 + len / 2) + Vector3.new(0, 0.09, 0)
		table.insert(S.cracks, part({
			Size = Vector3.new(0.7, 0.1, len),
			CFrame = CFrame.lookAt(mid, mid + outward),
			Material = Enum.Material.Neon,
			Color = GOLD,
			Transparency = 1,
			CastShadow = false,
		}))
	end
end

local function buildCrystal()
	-- Glass diamond + neon core + ForceField-material shell (animated shimmer).
	S.crystal = part({
		Size = Vector3.new(7, 7, 7),
		Material = Enum.Material.Glass,
		Color = VIOLET,
		Transparency = 0.15,
		Reflectance = 0.15,
		CastShadow = false,
	})
	S.core = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(235, 210, 255),
		CastShadow = false,
	})
	S.shell = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(12, 12, 12),
		Material = Enum.Material.ForceField,
		Color = VIOLET,
		CastShadow = false,
	})
	S.coreLight = new("PointLight", { Color = VIOLET, Range = 22, Brightness = 1.5, Shadows = true }, S.core)
	S.crystalAtt = new("Attachment", nil, S.core)
	new("Highlight", {
		FillTransparency = 1,
		OutlineColor = VIOLET,
		OutlineTransparency = 0.2,
		DepthMode = Enum.HighlightDepthMode.Occluded,
	}, S.crystal)
	S.crystalSpin = new("NumberValue", { Value = 0.4 }, sceneFolder)
	S.crystalAngle = 0
	S.crystalAlive = true

	-- Implosion particles: emitted on a 30-stud sphere, flying INWARD.
	local gatherZone = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(30, 30, 30),
		CFrame = CFrame.new(CRYSTAL),
		Transparency = 1,
	})
	S.gather = emitter(gatherZone, {
		Rate = 0,
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		Lifetime = NumberRange.new(1.2, 1.4),
		Speed = NumberRange.new(10, 12),
		Size = seq({ { 0, 0.2 }, { 0.7, 0.7 }, { 1, 0 } }),
		Transparency = seq({ { 0, 1 }, { 0.2, 0 }, { 1, 0 } }),
		Color = ColorSequence.new(CYAN, VIOLET),
	})

	-- Explosion emitters (fired with :Emit at the shatter).
	S.fxAnchor = part({ Size = Vector3.new(8, 2, 8), CFrame = CFrame.new(CRYSTAL), Transparency = 1 })
	S.dust = emitter(S.fxAnchor, {
		Texture = TEX.Smoke,
		Rate = 0,
		LightEmission = 0.2,
		LightInfluence = 1,
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(20, 45),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Size = seq({ { 0, 4 }, { 1, 14 } }),
		Transparency = seq({ { 0, 0.3 }, { 1, 1 } }),
		Color = ColorSequence.new(Color3.fromRGB(120, 90, 160)),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-40, 40),
	})
	S.sparks = emitter(S.fxAnchor, {
		Rate = 0,
		Lifetime = NumberRange.new(1, 2.5),
		Speed = NumberRange.new(40, 110),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 2,
		Acceleration = Vector3.new(0, -30, 0),
		Size = seq({ { 0, 1.2 }, { 1, 0 } }),
		Color = ColorSequence.new(WHITE, VIOLET),
	})
end

local function buildPillars()
	S.pillars = {}
	for i = 1, 8 do
		local a = (i - 1) / 8 * math.pi * 2
		local base = ORIGIN + Vector3.new(math.cos(a) * 42, 0, math.sin(a) * 42)
		local face = CFrame.lookAt(base, Vector3.new(ORIGIN.X, base.Y, ORIGIN.Z)) -- -Z faces the crystal
		part({ Size = Vector3.new(7, 2, 7), CFrame = face * CFrame.new(0, 1, 0), Material = Enum.Material.Slate, Color = STONE })
		part({ Size = Vector3.new(4, 26, 4), CFrame = face * CFrame.new(0, 15, 0), Material = Enum.Material.Slate, Color = STONE_LIGHT })
		local cap = part({ Size = Vector3.new(7, 2, 7), CFrame = face * CFrame.new(0, 29, 0), Material = Enum.Material.Slate, Color = STONE })
		local rune = part({
			Size = Vector3.new(1.4, 18, 0.3),
			CFrame = face * CFrame.new(0, 15, -2.1),
			Material = Enum.Material.SmoothPlastic,
			Color = DARK,
			CastShadow = false,
		})
		local tip = part({
			Size = Vector3.new(1.8, 1.8, 1.8),
			Material = Enum.Material.SmoothPlastic,
			Color = DARK,
			CastShadow = false,
		})
		-- Attachment rotated so its X axis points up: beams arc upward first.
		local att = new("Attachment", { CFrame = CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.rad(90)) }, cap)
		local coreBeam = new("Beam", {
			Attachment0 = att,
			Attachment1 = S.crystalAtt,
			Color = ColorSequence.new(WHITE, CYAN),
			LightEmission = 1,
			LightInfluence = 0,
			Width0 = 0.25,
			Width1 = 0.5,
			FaceCamera = true,
			Segments = 30,
			CurveSize0 = 14,
			Enabled = false,
		}, cap)
		local glowBeam = new("Beam", {
			Attachment0 = att,
			Attachment1 = S.crystalAtt,
			Color = ColorSequence.new(CYAN, VIOLET),
			LightEmission = 1,
			LightInfluence = 0,
			Texture = TEX.Sparkle,
			TextureMode = Enum.TextureMode.Wrap,
			TextureLength = 3,
			TextureSpeed = 2.5,
			Width0 = 1.2,
			Width1 = 2.2,
			FaceCamera = true,
			Segments = 30,
			CurveSize0 = 14,
			Enabled = false,
		}, cap)
		local light = new("PointLight", { Color = VIOLET, Range = 18, Brightness = 0 }, rune)
		local burst = emitter(rune, {
			Rate = 0,
			Lifetime = NumberRange.new(0.6, 1.2),
			Speed = NumberRange.new(3, 10),
			SpreadAngle = Vector2.new(180, 180),
			Size = seq({ { 0, 0.5 }, { 1, 0 } }),
			Color = ColorSequence.new(WHITE, VIOLET),
		})
		S.pillars[i] = {
			rune = rune,
			tip = tip,
			tipPos = face * Vector3.new(0, 33, 0),
			beams = { coreBeam, glowBeam },
			light = light,
			burst = burst,
		}
	end
end

local function buildSkyStuff()
	-- Orbiting, bobbing rock chunks.
	S.rocks = {}
	for _ = 1, 18 do
		local s = rng:NextNumber(3, 11)
		table.insert(S.rocks, {
			part = part({
				Size = Vector3.new(s, s * rng:NextNumber(0.6, 1), s * rng:NextNumber(0.7, 1.2)),
				Material = Enum.Material.Slate,
				Color = STONE,
			}),
			radius = rng:NextNumber(85, 135),
			angle = rng:NextNumber(0, math.pi * 2),
			y = rng:NextNumber(-30, 30),
			speed = rng:NextNumber(0.03, 0.08) * (rng:NextNumber() < 0.5 and -1 or 1),
			phase = rng:NextNumber(0, 10),
			spin = Vector3.new(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3)),
			lift = rng:NextNumber(0.6, 1.4),
		})
	end
	S.rockLift = new("NumberValue", { Value = 0 }, sceneFolder)

	-- Fireflies filling the air above the island.
	local zone = part({ Size = Vector3.new(140, 30, 140), CFrame = CFrame.new(ORIGIN + Vector3.new(0, 15, 0)), Transparency = 1 })
	S.fireflies = emitter(zone, {
		Rate = 35,
		Lifetime = NumberRange.new(4, 8),
		Speed = NumberRange.new(0.3, 1.5),
		SpreadAngle = Vector2.new(180, 180),
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		Acceleration = Vector3.new(0, 0.3, 0),
		Size = seq({ { 0, 0 }, { 0.2, 0.35 }, { 0.8, 0.35 }, { 1, 0 } }),
		Color = ColorSequence.new(Color3.fromRGB(190, 255, 150)),
	})
end

local function buildOrb()
	S.orbHeight = new("NumberValue", { Value = 0 }, sceneFolder)
	S.ringSpeed = new("NumberValue", { Value = 1 }, sceneFolder)
	S.pillarWidth = new("NumberValue", { Value = 0 }, sceneFolder)
	S.orbActive, S.ringT = false, 0

	S.orbCore = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(CRYSTAL),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 244, 214),
		Transparency = 1,
		CastShadow = false,
	})
	S.orbShell = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(16, 16, 16),
		CFrame = CFrame.new(CRYSTAL),
		Material = Enum.Material.ForceField,
		Color = GOLD,
		Transparency = 1,
		CastShadow = false,
	})
	S.orbLight = new("PointLight", { Color = GOLD, Range = 60, Brightness = 0, Shadows = true }, S.orbCore)
	S.orbAtt = new("Attachment", nil, S.orbCore)
	S.orbSparks = emitter(S.orbCore, {
		Rate = 0,
		Lifetime = NumberRange.new(1, 2),
		Speed = NumberRange.new(6, 14),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 1,
		Size = seq({ { 0, 0.8 }, { 1, 0 } }),
		Color = ColorSequence.new(WHITE, GOLD),
	})

	-- Three gyroscope rings made of neon dashes, each spinning on its own axes.
	S.rings = {}
	for i = 1, 3 do
		local radius = 9 + i * 3
		local count = 26
		local segs = {}
		for j = 1, count do
			segs[j] = {
				offset = CFrame.Angles(0, j / count * math.pi * 2, 0) * CFrame.new(radius, 0, 0),
				part = part({
					Size = Vector3.new(0.5, 0.5, radius * math.pi * 2 / count * 0.65),
					Material = Enum.Material.Neon,
					Color = i == 2 and CYAN or GOLD,
					Transparency = 1,
					CastShadow = false,
				}),
			}
		end
		local sign = i % 2 == 0 and -1 or 1
		S.rings[i] = {
			segs = segs,
			spin = Vector3.new(rng:NextNumber(0.4, 1.2), rng:NextNumber(0.6, 1.4), rng:NextNumber(0.3, 1)) * sign,
		}
	end

	-- Pillar of light that shoots into the sky.
	S.lightPillar = part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1200, 0.1, 0.1),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 236, 190),
		Transparency = 1,
		CastShadow = false,
	})
end

------------------------------------------------------------------------
-- PER-FRAME WORLD ANIMATION (dt is already time-scaled)
------------------------------------------------------------------------
local function groundHeight(flatDist)
	if flatDist < 7 then
		return 6
	elseif flatDist < 11 then
		return 4
	elseif flatDist < 15 then
		return 2
	elseif flatDist < 74 then
		return 0
	end
	return -math.huge
end

local function updateWorld(dt)
	sceneT += dt
	local t = sceneT

	if S.crystalAlive then
		S.crystalAngle += S.crystalSpin.Value * dt
		local pos = CRYSTAL + Vector3.new(0, math.sin(t * 1.4) * 0.6, 0)
		S.crystal.CFrame = CFrame.new(pos) * CFrame.Angles(0, S.crystalAngle, 0) * DIAMOND
		S.core.CFrame = CFrame.new(pos)
		S.shell.CFrame = CFrame.new(pos) * CFrame.Angles(0, -S.crystalAngle * 0.5, 0)
	end

	for i, p in ipairs(S.pillars) do
		p.tip.CFrame = CFrame.new(p.tipPos + Vector3.new(0, math.sin(t * 2 + i) * 0.4, 0))
			* CFrame.Angles(t * 1.3 + i, t * 2, 0.6)
	end

	for _, c in ipairs(S.circles) do
		local rot = t * 0.15 * c.dir
		for _, seg in ipairs(c.segs) do
			seg.part.CFrame = CIRCLE_BASE * CFrame.Angles(0, seg.angle + rot, 0) * CFrame.new(c.radius, 0, 0)
		end
	end

	local lift = S.rockLift.Value
	for _, r in ipairs(S.rocks) do
		r.angle += r.speed * dt * (1 + lift * 0.08)
		local pos = ORIGIN + Vector3.new(
			math.cos(r.angle) * r.radius,
			r.y + math.sin(t * 0.7 + r.phase) * 2 + lift * r.lift,
			math.sin(r.angle) * r.radius
		)
		r.part.CFrame = CFrame.new(pos) * CFrame.Angles(r.spin.X * t, r.spin.Y * t, r.spin.Z * t)
	end

	-- Hand-rolled shard physics, so bullet time can freeze them mid-air.
	for i = #S.shards, 1, -1 do
		local s = S.shards[i]
		if not s.resting then
			s.vel += GRAVITY * dt
			s.pos += s.vel * dt
			s.rot *= CFrame.Angles(s.ang.X * dt, s.ang.Y * dt, s.ang.Z * dt)
			local flat = Vector3.new(s.pos.X - ORIGIN.X, 0, s.pos.Z - ORIGIN.Z).Magnitude
			local floor = ORIGIN.Y + groundHeight(flat) + s.half
			if s.pos.Y < floor and s.vel.Y < 0 then
				s.pos = Vector3.new(s.pos.X, floor, s.pos.Z)
				s.vel = Vector3.new(s.vel.X * 0.55, -s.vel.Y * 0.3, s.vel.Z * 0.55)
				s.ang *= 0.5
				if s.vel.Magnitude < 4 then
					s.resting = true
				end
			end
			s.part.CFrame = CFrame.new(s.pos) * s.rot
			if s.pos.Y < ORIGIN.Y - 250 then
				s.part:Destroy()
				table.remove(S.shards, i)
			end
		end
	end

	if S.orbActive then
		local o = orbPos()
		S.orbCore.CFrame = CFrame.new(o)
		S.orbShell.CFrame = CFrame.new(o) * CFrame.Angles(0, t, 0)
		S.ringT += dt * S.ringSpeed.Value
		for _, ring in ipairs(S.rings) do
			local base = CFrame.new(o)
				* CFrame.Angles(ring.spin.X * S.ringT, ring.spin.Y * S.ringT, ring.spin.Z * S.ringT)
			for _, seg in ipairs(ring.segs) do
				seg.part.CFrame = base * seg.offset
			end
		end
		local w = S.pillarWidth.Value
		S.lightPillar.Size = Vector3.new(1200, math.max(w, 0.05), math.max(w, 0.05))
		S.lightPillar.CFrame = CFrame.new(o + Vector3.new(0, 600, 0)) * UPRIGHT
		S.lightPillar.Transparency = w < 0.1 and 1 or 0.2
	end

	local ts = timeScale.Value
	for _, e in ipairs(emitters) do
		e.TimeScale = ts
	end
end

local function onRender(dt)
	local sdt = dt * timeScale.Value
	updateWorld(sdt)

	for i = #scaledAnims, 1, -1 do
		local a = scaledAnims[i]
		a.t += sdt
		local x = math.min(a.t / a.d, 1)
		a.fn(TweenService:GetValue(x, a.style, a.dir))
		if x >= 1 then
			table.remove(scaledAnims, i)
			if a.done then
				a.done()
			end
		end
	end

	local cf, fov = evalShot()
	lastBaseCF = cf

	-- Perlin-noise camera shake ("trauma" squared feels natural).
	trauma = math.max(0, trauma - dt * 0.9)
	fovKick += (0 - fovKick) * math.min(1, dt * 5)
	local tr = math.max(trauma, rumble.Value)
	local s = tr * tr
	local n = os.clock() * 16
	local shake = CFrame.new(math.noise(n, 0.31) * s * 2, math.noise(n, 4.17) * s * 2, 0)
		* CFrame.Angles(math.noise(n, 7.73) * s * 0.08, math.noise(n, 11.9) * s * 0.08, math.noise(n, 15.3) * s * 0.12)

	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = cf * shake
	camera.FieldOfView = math.clamp(fov + fovKick, 8, 110)
end

------------------------------------------------------------------------
-- UI: letterbox, vignette, subtitles, flash, title card
------------------------------------------------------------------------
local skip -- forward declaration

local function textLabel(props)
	props.BackgroundTransparency = 1
	props.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	return new("TextLabel", props, U.gui)
end

local function buildUI()
	U.gui = new("ScreenGui", {
		Name = "AwakeningUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	local function frame(props)
		props.BorderSizePixel = 0
		return new("Frame", props, U.gui)
	end

	-- Vignette: four edge frames with transparency gradients.
	U.vignette = {}
	local edges = {
		{ UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.35, 0), 90 },
		{ UDim2.new(0, 0, 0.65, 0), UDim2.new(1, 0, 0.35, 0), -90 },
		{ UDim2.new(0, 0, 0, 0), UDim2.new(0.3, 0, 1, 0), 0 },
		{ UDim2.new(0.7, 0, 0, 0), UDim2.new(0.3, 0, 1, 0), 180 },
	}
	for _, e in ipairs(edges) do
		local f = frame({
			Position = e[1],
			Size = e[2],
			BackgroundColor3 = BLACK,
			BackgroundTransparency = VIGNETTE_BASE,
			ZIndex = 1,
		})
		new("UIGradient", { Rotation = e[3], Transparency = seq({ { 0, 0 }, { 1, 1 } }) }, f)
		table.insert(U.vignette, f)
	end

	U.barTop = frame({ Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = BLACK, ZIndex = 5 })
	U.barBot = frame({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = BLACK,
		ZIndex = 5,
	})
	U.flash = frame({ Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 8 })
	U.fade = frame({ Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = BLACK, BackgroundTransparency = 0, ZIndex = 9 })

	U.subtitle = textLabel({
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.9, 0, 0, 50),
		Font = SUB_FONT,
		TextSize = 30,
		TextColor3 = Color3.fromRGB(235, 225, 255),
		TextTransparency = 1,
		Text = "",
		ZIndex = 11,
	})
	U.subStroke = new("UIStroke", { Thickness = 1, Transparency = 1, Color = VIOLET }, U.subtitle)

	-- Title + two chromatic "ghost" copies for the glitch effect.
	U.titleScales = {}
	local function titleLabel(color, z)
		local label = textLabel({
			Position = UDim2.new(0.5, 0, 0.45, 0),
			Size = UDim2.new(0.85, 0, 0.16, 0),
			Font = TITLE_FONT,
			TextScaled = true,
			TextColor3 = color,
			TextTransparency = 1,
			Text = TITLE_TEXT,
			ZIndex = z,
		})
		new("UITextSizeConstraint", { MaxTextSize = 90 }, label)
		table.insert(U.titleScales, new("UIScale", { Scale = 1 }, label))
		return label
	end
	U.ghosts = { titleLabel(Color3.fromRGB(255, 40, 90), 12), titleLabel(Color3.fromRGB(40, 230, 255), 12) }
	U.title = titleLabel(WHITE, 13)
	U.titleGradient = new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, VIOLET),
			ColorSequenceKeypoint.new(0.5, CYAN),
			ColorSequenceKeypoint.new(1, GOLD),
		}),
	}, U.title)
	U.tagline = textLabel({
		Position = UDim2.new(0.5, 0, 0.58, 0),
		Size = UDim2.new(0.8, 0, 0, 24),
		Font = SUB_FONT,
		TextSize = 20,
		TextColor3 = Color3.fromRGB(200, 190, 230),
		TextTransparency = 1,
		Text = ("press %s to watch again"):format(CONFIG.REPLAY_KEY.Name),
		ZIndex = 13,
	})

	U.skip = new("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.new(0, 110, 0, 34),
		BackgroundColor3 = BLACK,
		BackgroundTransparency = 0.5,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = WHITE,
		Text = ("SKIP  [%s]"):format(CONFIG.SKIP_KEY.Name),
		AutoButtonColor = true,
		ZIndex = 14,
	}, U.gui)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, U.skip)
	new("UIStroke", { Color = WHITE, Transparency = 0.7, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, U.skip)
	U.skip.Activated:Connect(function()
		skip()
	end)
end

local function typewrite(label, text, duration)
	label.Text = text
	label.MaxVisibleGraphemes = 0
	local n = utf8.len(text) or #text
	for i = 1, n do
		label.MaxVisibleGraphemes = i
		task.wait(duration / n)
	end
	label.MaxVisibleGraphemes = -1
end

local function say(text, duration, hold, yScale)
	U.subtitle.Position = UDim2.new(0.5, 0, yScale or 0.5, 0)
	U.subtitle.TextTransparency = 0
	U.subStroke.Transparency = 0.6
	typewrite(U.subtitle, text, duration)
	task.wait(hold)
	tween(U.subtitle, 0.5, { TextTransparency = 1 })
	tween(U.subStroke, 0.5, { Transparency = 1 })
end

local function flash(color, strength, time)
	U.flash.BackgroundColor3 = color
	U.flash.BackgroundTransparency = 1 - strength
	tween(U.flash, time, { BackgroundTransparency = 1 })
end

local function vignettePulse(time)
	for _, f in ipairs(U.vignette) do
		f.BackgroundTransparency = 0
		tween(f, time, { BackgroundTransparency = VIGNETTE_BASE })
	end
end

local function scramble(final, revealed)
	local out = {}
	for i = 1, #final do
		local ch = final:sub(i, i)
		if i <= revealed or ch == " " then
			out[i] = ch
		else
			local r = rng:NextInteger(1, #GLYPHS)
			out[i] = GLYPHS:sub(r, r)
		end
	end
	return table.concat(out)
end

local function showTitle()
	U.title.TextTransparency = 0
	for _, g in ipairs(U.ghosts) do
		g.TextTransparency = 0.35
	end
	for _, scale in ipairs(U.titleScales) do
		scale.Scale = 1.3
		tween(scale, 2.4, { Scale = 1 }, Enum.EasingStyle.Quint)
	end
	U.titleGradient.Offset = Vector2.new(-0.6, 0)
	tween(U.titleGradient, 2.6, { Offset = Vector2.new(0.6, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	sfx(CONFIG.SOUNDS.Rune, 0.8, 0.3)

	-- "Decoding" glitch: random glyphs resolve left-to-right while the
	-- red/cyan ghosts jitter and settle.
	local steps = 22
	for i = 1, steps do
		local str = scramble(TITLE_TEXT, math.floor(i / steps * #TITLE_TEXT))
		U.title.Text = str
		local j = (steps - i) / steps * 10
		for _, g in ipairs(U.ghosts) do
			g.Text = str
			g.Position = U.title.Position + UDim2.fromOffset(rng:NextNumber(-j, j), rng:NextNumber(-j * 0.4, j * 0.4))
		end
		task.wait(0.045)
	end
	U.title.Text = TITLE_TEXT
	for _, g in ipairs(U.ghosts) do
		g.Text = TITLE_TEXT
		g.Position = U.title.Position
		tween(g, 0.6, { TextTransparency = 1 })
	end
	tween(U.tagline, 0.8, { TextTransparency = 0.2 })
end

------------------------------------------------------------------------
-- SET-PIECES
------------------------------------------------------------------------
local function ignite(i)
	local p = S.pillars[i]
	p.rune.Material = Enum.Material.Neon
	p.rune.Color = WHITE
	tween(p.rune, 0.7, { Color = VIOLET })
	p.tip.Material = Enum.Material.Neon
	p.tip.Color = WHITE
	tween(p.tip, 0.7, { Color = CYAN })
	p.light.Brightness = 8
	tween(p.light, 0.8, { Brightness = 3 })
	p.burst:Emit(45)
	for _, b in ipairs(p.beams) do
		b.Enabled = true
	end
	local glow = p.beams[2]
	glow.Width0, glow.Width1 = 5, 5
	tween(glow, 0.6, { Width0 = 1.2, Width1 = 2.2 })
	sfx(CONFIG.SOUNDS.Rune, 0.55, 0.55 + i * 0.12) -- rising pitch per pillar
	addShake(0.18)
	fovKick += 1.5
	tween(S.coreLight, 0.5, { Brightness = 1.5 + i * 0.5, Range = 22 + i * 2 })
end

local function lightningStrike(target)
	local color = BOLT_COLORS[rng:NextInteger(1, #BOLT_COLORS)]
	local top = target + Vector3.new(rng:NextNumber(-40, 40), 220, rng:NextNumber(-40, 40))
	local pieces = {}
	local function segment(a, b, width)
		table.insert(pieces, part({
			Size = Vector3.new(width, width, (b - a).Magnitude),
			CFrame = CFrame.lookAt((a + b) / 2, b),
			Material = Enum.Material.Neon,
			Color = color,
			CastShadow = false,
		}))
	end
	-- Jagged main bolt with random forks.
	local prev, count = top, 12
	for i = 1, count do
		local p = top:Lerp(target, i / count)
		if i < count then
			p += Vector3.new(rng:NextNumber(-9, 9), rng:NextNumber(-4, 4), rng:NextNumber(-9, 9))
		end
		segment(prev, p, 0.7)
		if i > 2 and i < count - 1 and rng:NextNumber() < 0.4 then
			segment(p, p + Vector3.new(rng:NextNumber(-30, 30), rng:NextNumber(-35, -10), rng:NextNumber(-30, 30)), 0.3)
		end
		prev = p
	end

	local impact = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(target), Transparency = 1 })
	local light = new("PointLight", { Color = color, Range = 60, Brightness = 18, Shadows = true }, impact)
	tween(light, 0.5, { Brightness = 0 })
	emitter(impact, {
		Rate = 0,
		Lifetime = NumberRange.new(0.4, 1),
		Speed = NumberRange.new(20, 50),
		SpreadAngle = Vector2.new(70, 70),
		Acceleration = Vector3.new(0, -60, 0),
		Size = seq({ { 0, 0.8 }, { 1, 0 } }),
		Color = ColorSequence.new(WHITE, color),
	}):Emit(40)

	flash(color, 0.45, 0.3)
	addShake(0.35)
	boom(target, false)

	spawnT(function()
		task.wait(0.06) -- flicker, like real lightning
		for _, p in ipairs(pieces) do
			p.Transparency = 0.7
		end
		task.wait(0.05)
		for _, p in ipairs(pieces) do
			p.Transparency = 0
			tween(p, 0.35, { Transparency = 1 })
		end
		task.wait(1.2)
		for _, p in ipairs(pieces) do
			p:Destroy()
		end
		impact:Destroy()
	end)
end

local function heartbeat(intensity)
	sfx(CONFIG.SOUNDS.Heartbeat, 1.2 * intensity, 0.35)
	fovKick -= 4 * intensity
	vignettePulse(0.6)
	addShake(0.15 * intensity)
	if S.crystalAlive then
		S.core.Size = Vector3.new(4.5, 4.5, 4.5)
		tween(S.core, 0.5, { Size = Vector3.new(3, 3, 3) })
		S.coreLight.Brightness = 10
		tween(S.coreLight, 0.6, { Brightness = 2 })
	end
	S.blur.Size = 10
	tween(S.blur, 0.5, { Size = 1 })
end

local function spawnShards(origin)
	for i = 1, 46 do
		local s = rng:NextNumber(0.5, 2.2)
		local glass = i % 3 ~= 0
		local color = i % 2 == 0 and VIOLET or CYAN
		local dir = rng:NextUnitVector()
		dir = Vector3.new(dir.X, math.abs(dir.Y) * 0.9 + 0.15, dir.Z).Unit
		local pos = origin + dir * 1.5
		local p = part({
			Size = Vector3.new(s * 0.55, s * 1.7, s * 0.55),
			CFrame = CFrame.new(pos),
			Material = glass and Enum.Material.Glass or Enum.Material.Neon,
			Color = color,
			Transparency = glass and 0.1 or 0,
			Reflectance = glass and 0.25 or 0,
			CastShadow = false,
		})
		local a0 = new("Attachment", { Position = Vector3.new(0, s * 0.8, 0) }, p)
		local a1 = new("Attachment", { Position = Vector3.new(0, -s * 0.8, 0) }, p)
		new("Trail", {
			Attachment0 = a0,
			Attachment1 = a1,
			Lifetime = 0.35,
			LightEmission = 1,
			FaceCamera = true,
			Color = ColorSequence.new(color),
			Transparency = seq({ { 0, 0.2 }, { 1, 1 } }),
		}, p)
		table.insert(S.shards, {
			part = p,
			pos = pos,
			vel = dir * rng:NextNumber(30, 95),
			rot = CFrame.Angles(rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28), rng:NextNumber(0, 6.28)),
			ang = Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10), rng:NextNumber(-10, 10)),
			half = s * 0.3,
		})
	end
end

local function shatter()
	local pos = S.core.Position
	S.crystalAlive = false
	S.crystal:Destroy()
	S.shell:Destroy()
	S.core.Transparency = 1
	S.gather.Enabled = false
	for _, p in ipairs(S.pillars) do
		for _, b in ipairs(p.beams) do
			b.Enabled = false
		end
		p.rune.Color = Color3.fromRGB(120, 40, 60)
		tween(p.light, 0.3, { Brightness = 0.4 })
	end

	flash(WHITE, 1, 1.1)
	boom(pos, true)
	sfx(CONFIG.SOUNDS.Shatter, 1, 0.8)
	sfx(CONFIG.SOUNDS.Shatter, 0.8, 0.45)
	addShake(1)
	fovKick += 20
	S.dust:Emit(70)
	S.sparks:Emit(160)
	spawnShards(pos)

	-- Shockwaves: a flat ring across the ground and a tilted one through
	-- the blast. Both use scaledAnim so they freeze in bullet time.
	local function shockwave(cf, maxSize, duration)
		local ring = part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 4, 4),
			CFrame = cf,
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(225, 190, 255),
			CastShadow = false,
		})
		scaledAnim(duration, function(a)
			local d = 4 + a * maxSize
			ring.Size = Vector3.new(0.6, d, d)
			ring.Transparency = a
		end, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, function()
			ring:Destroy()
		end)
	end
	shockwave(CFrame.new(ORIGIN + Vector3.new(0, 1.2, 0)) * UPRIGHT, 320, 1.8)
	shockwave(CFrame.new(pos) * CFrame.Angles(math.rad(65), math.rad(30), 0) * UPRIGHT, 140, 1.4)

	local sphere = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(pos),
		Material = Enum.Material.Neon,
		Color = WHITE,
		CastShadow = false,
	})
	local burst = new("PointLight", { Color = Color3.fromRGB(230, 200, 255), Range = 60, Brightness = 20 }, sphere)
	scaledAnim(0.9, function(a)
		local d = 2 + a * 60
		sphere.Size = Vector3.new(d, d, d)
		sphere.Transparency = a
		burst.Brightness = 20 * (1 - a)
	end, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
		sphere:Destroy()
	end)

	for i, c in ipairs(S.cracks) do
		tween(c, 0.3 + i * 0.05, { Transparency = 0 })
	end
	S.bloom.Intensity = 4
	tween(S.bloom, 1.5, { Intensity = 1.4 })
	S.cc.Brightness = 0.4
	tween(S.cc, 1, { Brightness = 0 })
end

------------------------------------------------------------------------
-- THE TIMELINE
------------------------------------------------------------------------
local function runTimeline()
	t0 = os.clock()
	local SND = CONFIG.SOUNDS
	local G, C = ORIGIN, CRYSTAL

	-- 00:00 ─ COLD OPEN ─────────────────────────────────────────────
	tween(U.barTop, 1.6, { Size = UDim2.new(1, 0, 0.11, 0) }, Enum.EasingStyle.Quart)
	tween(U.barBot, 1.6, { Size = UDim2.new(1, 0, 0.11, 0) }, Enum.EasingStyle.Quart)
	SoundService.AmbientReverb = Enum.ReverbType.Mountains
	S.drone = sfx(SND.Drone, 0, 0.45, true)
	if S.drone then
		new("ReverbSoundEffect", { DecayTime = 4, WetLevel = 0 }, S.drone)
		tween(S.drone, 4, { Volume = 0.35 })
	end
	if CONFIG.MUSIC_ID ~= "" then
		S.music = sfx(CONFIG.MUSIC_ID, 0, 1, true)
		if S.music then
			tween(S.music, 3, { Volume = CONFIG.MUSIC_VOLUME })
		end
	end
	spawnT(function()
		at(0.4)
		say("Long before the first server ever started...", 1.6, 0.6)
		at(3.1)
		say("...something was already dreaming.", 1.2, 0.5)
	end)

	-- 00:04 ─ ESTABLISHING FLY-OVER ─────────────────────────────────
	at(4.2)
	shotPath(9, {
		G + Vector3.new(-230, 110, 190),
		G + Vector3.new(-120, 30, 210),
		G + Vector3.new(40, 60, 150),
		G + Vector3.new(95, 40, 90),
	}, { G + Vector3.new(0, -30, 0), G, C }, 62, 48)
	at(5)
	tween(U.fade, 2.5, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	tween(S.dof, 8, { FocusDistance = 45 })

	-- 00:13 ─ THE RUNES IGNITE ──────────────────────────────────────
	at(13.2)
	-- Low dolly outside the pillar ring: pillars slide past in the foreground.
	shotOrbit(4.2, G + Vector3.new(0, 12, 0), 58, 52, -6, -4, 20, 110, 50, 46)
	spawnT(function()
		for i = 1, 8 do
			at(13.5 + (i - 1) * 0.9)
			ignite(i)
		end
	end)
	at(17.4)
	-- Worm's-eye view under the crystal as the beams converge.
	shotPath(3.6, { C + Vector3.new(16, -11, 20), C + Vector3.new(10, -9, 14) }, { C + Vector3.new(0, 2, 0), C }, 55, 46)

	-- 00:21 ─ AWAKENING ─────────────────────────────────────────────
	at(21)
	shotOrbit(7, C, 40, 14, 10, 1, 55, 55 + 540, 55, 36) -- tightening 1.5-turn spiral
	tween(S.crystalSpin, 7, { Value = 14 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(S.rockLift, 7, { Value = 22 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	tween(S.gather, 2, { Rate = 120 })
	tween(S.rumble, 7, { Value = 0.22 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(S.cc, 7, { TintColor = Color3.fromRGB(225, 205, 255), Saturation = 0.35, Contrast = 0.2 })
	tween(S.bloom, 7, { Intensity = 1.8, Size = 40, Threshold = 0.75 })
	tween(S.atmosphere, 7, { Color = Color3.fromRGB(150, 80, 210), Decay = Color3.fromRGB(90, 30, 130) })
	tween(S.coreLight, 7, { Brightness = 8, Range = 45 })
	if S.drone then
		tween(S.drone, 7, { PlaybackSpeed = 1.5, Volume = 0.7 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	for _, c in ipairs(S.circles) do -- "draw" the magic circles dash by dash
		spawnT(function()
			for _, seg in ipairs(c.segs) do
				seg.part.Color = VIOLET
				task.wait(0.03)
			end
		end)
	end

	-- 00:28 ─ THE STORM ─────────────────────────────────────────────
	at(28)
	tween(S.rumble, 0.5, { Value = 0.3 })
	shotPath(3, { G + Vector3.new(-85, 5, -65), G + Vector3.new(-72, 9, -82) }, { C + Vector3.new(0, 6, 0), C + Vector3.new(0, 10, 0) }, 68, 60)
	tween(Lighting, 1.5, { Ambient = Color3.fromRGB(80, 20, 45), OutdoorAmbient = Color3.fromRGB(110, 30, 60) })
	tween(S.atmosphere, 1.5, { Color = Color3.fromRGB(160, 40, 90), Decay = Color3.fromRGB(90, 10, 40), Density = 0.4 })
	tween(S.cc, 1.5, { TintColor = Color3.fromRGB(255, 205, 220), Contrast = 0.3 })
	tween(S.crystalSpin, 3, { Value = 24 })
	spawnT(function()
		while os.clock() - t0 < 33.8 do
			local target
			if rng:NextNumber() < 0.35 then
				target = S.pillars[rng:NextInteger(1, 8)].tipPos
			else
				local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(10, 70)
				target = G + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			end
			lightningStrike(target)
			task.wait(rng:NextNumber(0.18, 0.45))
		end
	end)
	at(31)
	-- God's-eye view, slowly rotating, descending.
	setShot(3, function(a)
		local ang = a * math.pi * 0.9 + 0.3
		local pos = C + Vector3.new(0, 120 - a * 35, 0)
		return CFrame.lookAt(pos, C, Vector3.new(math.cos(ang), 0, math.sin(ang))), 62
	end, Enum.EasingStyle.Linear)

	-- 00:34 ─ SILENCE ───────────────────────────────────────────────
	at(34)
	tween(S.rumble, 0.3, { Value = 0 })
	if S.drone then
		tween(S.drone, 0.4, { Volume = 0.04 })
	end
	if S.music then
		tween(S.music, 0.6, { Volume = CONFIG.MUSIC_VOLUME * 0.25 })
	end
	tween(S.crystalSpin, 1, { Value = 0.3 })
	S.gather.Rate = 0
	tween(S.cc, 0.6, { Saturation = -0.75, TintColor = WHITE, Contrast = 0.35 })
	tween(S.bloom, 0.6, { Intensity = 0.8 })
	tween(Lighting, 0.8, { Ambient = Color3.fromRGB(25, 20, 35), OutdoorAmbient = Color3.fromRGB(40, 30, 55) })
	shotPath(3, { C + Vector3.new(0, 1.5, 26), C + Vector3.new(0, 0.8, 10) }, { C, C }, 48, 30, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	spawnT(function()
		at(34.2)
		say("...it's awake.", 0.8, 1.2, 0.8)
	end)
	spawnT(function()
		for _, beat in ipairs({ { 34.35, 0.7 }, { 35.25, 0.85 }, { 36.0, 1 }, { 36.55, 1.15 } }) do
			at(beat[1])
			heartbeat(beat[2])
		end
	end)

	-- 00:37 ─ SHATTER ───────────────────────────────────────────────
	at(37)
	shatter()
	S.cc.Saturation = 0.4
	-- Camera gets "blown back" by the blast.
	shotPath(0.7, { C + Vector3.new(0, 0.8, 10), C + Vector3.new(0, 5, 32) }, { C, C }, 30, 62, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

	-- 00:37.4 ─ BULLET TIME ─────────────────────────────────────────
	at(37.4)
	tween(timeScale, 0.6, { Value = 0.03 })
	sfx(SND.Whoosh, 0.8, 0.45)
	if S.music then
		tween(S.music, 0.6, { PlaybackSpeed = 0.55 })
	end
	if S.drone then
		tween(S.drone, 0.6, { PlaybackSpeed = 0.22, Volume = 0.5 })
	end
	tween(S.cc, 0.8, { Saturation = -0.1, TintColor = Color3.fromRGB(200, 235, 255), Contrast = 0.45, Brightness = 0.02 })
	tween(S.dof, 0.8, { FocusDistance = 30, InFocusRadius = 14, FarIntensity = 0.6, NearIntensity = 0.5 })
	at(37.7)
	-- Matrix-style orbit around the frozen explosion.
	shotOrbit(6.5, C + Vector3.new(0, 3, 0), 32, 26, 2, 3, 90, 300, 62, 48)
	at(41)
	heartbeat(0.6)
	at(44.1)
	sfx(SND.Whoosh, 1, 0.8)
	tween(timeScale, 0.35, { Value = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	if S.music then
		tween(S.music, 0.4, { PlaybackSpeed = 1, Volume = CONFIG.MUSIC_VOLUME })
	end
	addShake(0.5)
	fovKick += 12
	tween(S.cc, 0.5, { Saturation = 0.2, TintColor = WHITE, Contrast = 0.2, Brightness = 0 })
	tween(S.dof, 0.5, { FocusDistance = 60, InFocusRadius = 50, FarIntensity = 0.3, NearIntensity = 0.3 })

	-- 00:44.6 ─ ASCENSION ───────────────────────────────────────────
	at(44.6)
	setShot(4.9, function(a) -- low hero angle, tracking the orb
		local pos = C + Vector3.new(22, -10, 26):Lerp(Vector3.new(15, -9, 18), a)
		return CFrame.lookAt(pos, orbPos()), lerp(50, 68, a)
	end)
	at(45)
	S.orbActive = true
	S.orbCore.Transparency = 0
	S.orbCore.Size = Vector3.new(0.5, 0.5, 0.5)
	tween(S.orbCore, 1.2, { Size = Vector3.new(9, 9, 9) }, Enum.EasingStyle.Back)
	tween(S.orbShell, 1.5, { Transparency = 0 })
	tween(S.orbLight, 1.5, { Brightness = 6 })
	tween(S.orbHeight, 8, { Value = 42 }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	S.orbSparks.Rate = 40
	flash(GOLD, 0.5, 0.8)
	sfx(SND.Rune, 1, 0.35)
	if S.drone then
		tween(S.drone, 2, { PlaybackSpeed = 0.8, Volume = 0.3 })
	end
	for _, ring in ipairs(S.rings) do
		spawnT(function()
			for _, seg in ipairs(ring.segs) do
				tween(seg.part, 0.3, { Transparency = 0 })
				task.wait(0.025)
			end
		end)
	end
	for i, p in ipairs(S.pillars) do -- pillars re-ignite in gold and feed the orb
		spawnT(function()
			task.wait(i * 0.08)
			p.rune.Color = GOLD
			p.tip.Color = GOLD
			p.light.Color = GOLD
			tween(p.light, 0.4, { Brightness = 4 })
			p.burst:Emit(30)
			for _, b in ipairs(p.beams) do
				b.Attachment1 = S.orbAtt
				b.Color = ColorSequence.new(GOLD, WHITE)
				b.Enabled = true
			end
		end)
	end
	-- Dawn breaks: ClockTime sweeps from midnight to sunrise.
	tween(Lighting, 8, {
		ClockTime = 6.3,
		Ambient = Color3.fromRGB(110, 85, 60),
		OutdoorAmbient = Color3.fromRGB(150, 115, 80),
		Brightness = 2.2,
	}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	tween(S.atmosphere, 8, { Color = Color3.fromRGB(255, 190, 130), Decay = Color3.fromRGB(200, 110, 70), Density = 0.3, Glare = 1.5 })
	tween(S.cc, 4, { TintColor = Color3.fromRGB(255, 238, 210), Saturation = 0.3 })
	tween(S.sunRays, 8, { Intensity = 0.15 })
	S.fireflies.Color = ColorSequence.new(GOLD)
	S.fireflies.Rate = 60

	at(46.4)
	tween(S.pillarWidth, 0.8, { Value = 7 }, Enum.EasingStyle.Back)
	sfx(SND.Whoosh, 1, 0.6)
	addShake(0.45)
	flash(WHITE, 0.6, 0.6)

	at(49.5)
	setShot(3.6, function(a) -- crane shot rising alongside the orb
		local o = orbPos()
		local ang = math.rad(lerp(30, 120, a))
		return CFrame.lookAt(o + Vector3.new(math.cos(ang) * 54, lerp(-14, 4, a), math.sin(ang) * 54), o), lerp(58, 50, a)
	end)

	-- 00:53 ─ SUPERNOVA ─────────────────────────────────────────────
	at(53.1)
	local from = lastBaseCF.Position
	setShot(2.6, function(a) -- huge pull-back reveal
		local pos = bezier({ from, from + Vector3.new(-40, 30, 40), C + Vector3.new(-230, 110, 230) }, a)
		return CFrame.lookAt(pos, orbPos()), lerp(52, 70, a)
	end, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
	tween(S.orbCore, 2.4, { Size = Vector3.new(16, 16, 16) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(S.ringSpeed, 2.4, { Value = 6 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(S.orbLight, 2.4, { Brightness = 12 })
	tween(S.rumble, 2.4, { Value = 0.35 })
	if S.drone then
		tween(S.drone, 2.4, { PlaybackSpeed = 1.8, Volume = 0.8 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	at(55.5)
	local nova = part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(10, 10, 10),
		CFrame = CFrame.new(orbPos()),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 248, 230),
		CastShadow = false,
	})
	tween(nova, 1.2, { Size = Vector3.new(900, 900, 900) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	boom(lastBaseCF.Position, false) -- invisible explosion right at the camera = loud boom
	sfx(SND.Shatter, 1, 0.35)
	addShake(1)
	U.flash.BackgroundColor3 = WHITE
	tween(U.flash, 0.7, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(S.bloom, 0.7, { Intensity = 5 })

	at(56.3)
	tween(U.fade, 0.9, { BackgroundTransparency = 0 })
	if S.drone then
		tween(S.drone, 3, { Volume = 0 })
	end
	if S.music then
		tween(S.music, 3.5, { Volume = 0 })
	end
	at(56.9)
	spawnT(showTitle)
	at(59.3)
	tween(U.title, 0.6, { TextTransparency = 1 })
	tween(U.tagline, 0.6, { TextTransparency = 1 })
	at(60)
end

------------------------------------------------------------------------
-- PLAY / FINISH
------------------------------------------------------------------------
local function finish(skipped)
	if not playing or finishing then
		return
	end
	finishing = true
	local me = coroutine.running()
	for _, th in ipairs(threads) do
		if th ~= me then
			pcall(task.cancel, th)
		end
	end
	for _, tw in ipairs(tweens) do
		tw:Cancel()
	end
	U.skip.Visible = false
	if skipped then
		TweenService:Create(U.fade, TweenInfo.new(0.35), { BackgroundTransparency = 0 }):Play()
		task.wait(0.4)
	end
	U.fade.BackgroundTransparency = 0
	for _, label in ipairs({ U.subtitle, U.title, U.tagline, U.ghosts[1], U.ghosts[2] }) do
		label.Visible = false
	end

	RunService:UnbindFromRenderStep(RENDER_NAME)
	sceneFolder:Destroy()
	for _, inst in ipairs(created) do
		inst:Destroy()
	end
	restoreEnvironment()

	task.wait(0.3)
	TweenService:Create(U.fade, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(U.barTop, TweenInfo.new(1.2, Enum.EasingStyle.Quart), { Size = UDim2.new(1, 0, 0, 0) }):Play()
	TweenService:Create(U.barBot, TweenInfo.new(1.2, Enum.EasingStyle.Quart), { Size = UDim2.new(1, 0, 0, 0) }):Play()
	for _, f in ipairs(U.vignette) do
		TweenService:Create(f, TweenInfo.new(1.2), { BackgroundTransparency = 1 }):Play()
	end
	task.wait(1.3)
	U.gui:Destroy()

	cooldownUntil = os.clock() + 3
	playing, finishing = false, false
end

function skip()
	if playing and not finishing then
		task.spawn(finish, true)
	end
end

local function play()
	if playing or os.clock() < cooldownUntil then
		return
	end
	playing, finishing = true, false
	camera = workspace.CurrentCamera
	created, tweens, threads, emitters, scaledAnims = {}, {}, {}, {}, {}
	S = { shards = {} }
	U = {}
	trauma, fovKick, sceneT, camShot = 0, 0, 0, nil
	lastBaseCF = camera.CFrame

	saveEnvironment()
	if controls then
		controls:Disable()
	end
	for kind in pairs(saved.coreGui) do
		pcall(StarterGui.SetCoreGuiEnabled, StarterGui, kind, false)
	end
	UserInputService.MouseIconEnabled = false

	sceneFolder = new("Folder", { Name = "AwakeningCinematic" }, workspace)
	timeScale = new("NumberValue", { Value = 1 }, sceneFolder)
	rumble = new("NumberValue", { Value = 0 }, sceneFolder)
	S.rumble = rumble

	buildUI()
	buildLighting()
	buildIsland()
	buildCrystal()
	buildPillars()
	buildSkyStuff()
	buildOrb()

	RunService:BindToRenderStep(RENDER_NAME, Enum.RenderPriority.Camera.Value + 1, onRender)
	local main = task.spawn(function()
		runTimeline()
		finish(false)
	end)
	table.insert(threads, main)
end

------------------------------------------------------------------------
-- TRIGGERS
------------------------------------------------------------------------
task.spawn(function()
	controls = getControls()
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == CONFIG.SKIP_KEY then
		skip()
	elseif input.KeyCode == CONFIG.REPLAY_KEY then
		play()
	end
end)

local function hookTrigger(inst)
	if inst:IsA("BasePart") and inst.Name == CONFIG.TRIGGER_PART_NAME then
		inst.Touched:Connect(function(hit)
			local character = player.Character
			if character and hit:IsDescendantOf(character) then
				play()
			end
		end)
	end
end
for _, inst in ipairs(workspace:GetDescendants()) do
	hookTrigger(inst)
end
workspace.DescendantAdded:Connect(hookTrigger)

if CONFIG.PLAY_ON_JOIN then
	task.spawn(function()
		if not player.Character then
			player.CharacterAdded:Wait()
		end
		task.wait(CONFIG.JOIN_DELAY)
		play()
	end)
end
]]></ProtectedString>
		</Properties>
	</Item>
</roblox>
